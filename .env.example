# FomoScan GET /v2/leaderboard/traders (keeper / client tests).
FOMOSCAN_API_KEY=

# Optional spare for a one-shot cache seed.
FOMOSCAN_API_KEY_2=

# Resolver / script signer (JSON byte array).
# Locally, falls back to ~/.config/solana/id.json when unset. Never commit a real key.
FOMO_SERVER_KEYPAIR=

# Optional. Scripts (e2e / seed) read this; falls back to public devnet.
SOLANA_RPC_URL=https://api.devnet.solana.com
