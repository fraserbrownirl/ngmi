# FomoScan GET /v2/leaderboard/traders (keeper / client tests).
FOMOSCAN_API_KEY=

# Optional spare for a one-shot cache seed.
FOMOSCAN_API_KEY_2=

# Optional third live key (paid board). Used for the hourly FOMO + daily pump.fun pulls when the primary cannot afford 250 CU.
FOMOSCAN_API_KEY_3=

# Optional fourth live key (paid board). Tried before key 3.
FOMOSCAN_API_KEY_4=

# Resolver / script signer (JSON byte array).
# Locally, falls back to ~/.config/solana/id.json when unset. Never commit a real key.
FOMO_SERVER_KEYPAIR=

# Optional. Scripts (e2e / seed) read this; falls back to public devnet.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Mainnet init roles (pnpm mainnet:init; scripts/cluster-init.ts). Public keys,
# not secrets. MAINNET_ACK=YES is the required acknowledgment gate.
MAINNET_ADMIN=
MAINNET_FOUNDER=
MAINNET_RESOLVER=
# Required. Agent treasury owner (dedicated ops key) — the program rejects
# burn == agent treasury, and one owner has exactly one ATA per mint.
MAINNET_AGENT_TREASURY_OWNER=
# Optional. Defaults: rake owner = admin; burn treasury owner = rake owner;
# fee recipient = admin; MODE = squads (emit payloads, nothing privileged signed).
MAINNET_RAKE_OWNER=
MAINNET_BURN_TREASURY_OWNER=
MAINNET_FEE_RECIPIENT=
MAINNET_MODE=

# Trading-agent sim (services/sim; pnpm sim:fund / sim:run / sim:report).
# Agents only place_bet + claim_winnings on existing markets; the keeper resolves.
# SIM_AGENT_KEYPAIRS defaults to ~/.config/fomo/sim-agent-{1,2,3}.json.
SIM_AGENT_KEYPAIRS=
SIM_MAX_BET_USDC=
SIM_DAILY_SPEND_USDC=
SIM_BANKROLL_FLOOR_USDC=
SIM_SOL_FLOOR=
SIM_WAKE_MIN_SEC=
SIM_WAKE_MAX_SEC=
SIM_EDGE_MARGIN=
SIM_PROXIMITY_GUARD=
SIM_MIN_BET_USDC=
SIM_BET_FRACTION_MIN=
SIM_BET_FRACTION_MAX=
SIM_MAX_MARKET_EXPOSURE_USDC=
SIM_CONVICTION_JITTER=
SIM_FUND_USDC=
SIM_FUND_SOL=
SIM_DATA_DIR=
MAINNET_ACK=
# Optional. Used to build the default mainnet RPC when SOLANA_RPC_URL is unset.
HELIUS_API_KEY=

# Optional. TwitterAPI.io — @ngmi_cto platform events (new market, new bet, resolved) and group copy.
TWITTERAPI_API_KEY=
# Sticky Webshare URL for @ngmi_cto v2 login + writes (`http://user:pass@host:port`). Same proxy every call.
TWITTERAPI_PROXY=
# Webshare dashboard API token for the CTO proxy account (proxy list management).
WEBSHARE_API_KEY=
# Webshare dashboard login password (operator reference; not read by code).
WEBSHARE_ACCOUNT_PASSWORD=
# Fallback proxy parts, assembled only when TWITTERAPI_PROXY is unset.
PROXY_ADDRESS=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=
TWITTER_CTO_USERNAME=ngmi_cto
TWITTER_CTO_EMAIL=
TWITTER_CTO_PASSWORD=
# TOTP seed (base32), not a 6-digit code.
TWITTER_CTO_TOTP_SECRET=
# Optional. X auth_token cookie to resume a session instead of email/password.
TWITTER_CTO_AUTH_TOKEN=
TWITTER_CTO_CT0=
X_CLIENT_ID=
X_CLIENT_SECRET=
# Exact callback registered in the portal. Default: http://localhost:3000/api/oauth/x/callback
X_OAUTH_REDIRECT_URI=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. Mainnet RPC for the followed trader's wallet tickers (not the tote cluster).
SOLANA_MAINNET_RPC_URL=

# Gates every privileged tote route (/api/admin/stats, /api/keeper/tick,
# /api/announce, /api/traders, /api/oauth/x/status). Header or Bearer only.
# Production denies those routes when this is unset.
ADMIN_TOKEN=

# Optional. Bearer-only token for GET /api/keeper/tick (GitHub Actions hourly
# board refresh + Vercel cron). Does not unlock other admin routes. Vercel
# attaches Authorization: Bearer $CRON_SECRET on cron invocations when set.
CRON_SECRET=

# Optional. Allow local/preview tote to spend paid FomoScan board keys.
# Production (VERCEL_ENV=production) always may. Public GET never pulls.
FOMO_LIVE_BOARD=

# Optional. Tote cluster: devnet (default) or mainnet. Faucet and demo routes
# only answer on devnet; production settles refuse the config admin key.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Public-group feedback bot (services/telegram-bot). Never commit a real token.
TELEGRAM_BOT_TOKEN=
# Optional. Group chat id (negative for groups / supergroups). If unset, any group the bot is in.
TELEGRAM_GROUP_ID=

# App Bearer from X Developer Console → Apps → Keys and tokens. Never commit.
# Used by the feedback bot to copy new @ngmidotmarkets posts into the group.
TWITTER_BEARER_TOKEN=
# Official handle to share (no @). Default ngmidotmarkets.
TWITTER_USERNAME=ngmidotmarkets

# CTO / film handle to copy into the group via TwitterAPI.io. Default ngmi_cto.
# Max Turbo / Endless Channel posts as memedottv.
TWITTERAPI_CTO_USERNAME=memedottv
