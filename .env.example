# FomoScan GET /v2/leaderboard/traders (keeper / client tests).
FOMOSCAN_API_KEY=

# Optional spare for a one-shot cache seed.
FOMOSCAN_API_KEY_2=

# Optional third live key (paid board). Used for the hourly FOMO + daily pump.fun pulls when the primary cannot afford 250 CU.
FOMOSCAN_API_KEY_3=

# Resolver / script signer (JSON byte array).
# Locally, falls back to ~/.config/solana/id.json when unset. Never commit a real key.
FOMO_SERVER_KEYPAIR=

# Optional. Scripts (e2e / seed) read this; falls back to public devnet.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional. TwitterAPI.io — @ngmi_cto platform events (new market, new bet, resolved) and group copy.
TWITTERAPI_API_KEY=
# Residential proxy for the one-time v3 login (`http://user:pass@host:port`). Later posts do not need it.
TWITTERAPI_PROXY=
TWITTER_CTO_USERNAME=ngmi_cto
TWITTER_CTO_EMAIL=
TWITTER_CTO_PASSWORD=
# TOTP seed (base32), not a 6-digit code.
TWITTER_CTO_TOTP_SECRET=
# Optional. X auth_token cookie to resume a session instead of email/password.
TWITTER_CTO_AUTH_TOKEN=
TWITTER_CTO_CT0=
X_CLIENT_ID=
X_CLIENT_SECRET=
# Exact callback registered in the portal. Default: http://localhost:3000/api/oauth/x/callback
X_OAUTH_REDIRECT_URI=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. Mainnet RPC for the followed trader's wallet tickers (not the tote cluster).
SOLANA_MAINNET_RPC_URL=

# Optional. Gates the local tote /api/admin/stats. Leave empty on a private machine.
ADMIN_TOKEN=

# Public-group feedback bot (services/telegram-bot). Never commit a real token.
TELEGRAM_BOT_TOKEN=
# Optional. Group chat id (negative for groups / supergroups). If unset, any group the bot is in.
TELEGRAM_GROUP_ID=

# App Bearer from X Developer Console → Apps → Keys and tokens. Never commit.
# Used by the feedback bot to copy new @ngmidotmarkets posts into the group.
TWITTER_BEARER_TOKEN=
# Official handle to share (no @). Default ngmidotmarkets.
TWITTER_USERNAME=ngmidotmarkets

# CTO handle to copy into the group via TwitterAPI.io (same key as above). Default ngmi_cto.
TWITTERAPI_CTO_USERNAME=ngmi_cto
