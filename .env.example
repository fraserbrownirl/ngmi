# Required for the tote board and keeper (FomoScan GET /v2/leaderboard/traders).
FOMOSCAN_API_KEY=

# Optional spare. The app spends this at most once to seed a disk cache.
FOMOSCAN_API_KEY_2=

# Server-side signer for resolve + devnet faucet routes (JSON byte array).
# Locally, falls back to ~/.config/solana/id.json when unset. Never commit a real key.
FOMO_SERVER_KEYPAIR=

# Public RPC used by the Next.js client and server signer. Defaults to devnet.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional. Scripts (e2e / seed) read this; falls back to public devnet.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional. Local app URL for seed/e2e scripts.
APP_URL=http://localhost:3000
