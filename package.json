{
  "name": "fomopred",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "test": "pnpm --filter @fomopred/shared test && pnpm --filter @fomopred/fomoscan test && pnpm --filter @fomopred/keeper test",
    "dev": "pnpm --filter @fomopred/web dev",
    "build": "pnpm --filter @fomopred/web build",
    "smoke:devnet": "pnpm exec ts-mocha -p ./tsconfig.json -t 180000 scripts/devnet-smoke.ts",
    "test:e2e": "pnpm exec ts-mocha -p ./tsconfig.json -t 300000 scripts/e2e-devnet.ts",
    "seed:scenarios": "pnpm exec ts-mocha -p ./tsconfig.json -t 300000 scripts/seed-scenario-pots.ts",
    "test:cluster": "pnpm exec ts-mocha -p ./tsconfig.json -t 300000 scripts/seed-scenario-pots.ts"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "^1.5.5",
    "@codama/renderers-js": "^2.3.1",
    "@coral-xyz/anchor": "^0.32.1",
    "@fomopred/fomo-pnl-client": "workspace:^",
    "@fomopred/shared": "workspace:*",
    "@solana-program/system": "^0.14.0",
    "@solana-program/token": "^0.16.0",
    "@solana/kit": "^8.0.0",
    "@solana/kit-plugin-rpc": "^0.18.0",
    "@solana/kit-plugin-signer": "^0.18.0",
    "@solana/spl-token": "^0.4.14",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "chai": "^4.3.4",
    "codama": "^1.10.2",
    "mocha": "^9.0.3",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.7.3"
  }
}
