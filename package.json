{
  "name": "fomopred",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "test": "pnpm --filter @fomopred/shared test && pnpm --filter @fomopred/fomoscan test && pnpm --filter @fomopred/keeper test && pnpm --filter @fomopred/telegram-bot test && pnpm --filter @fomopred/sim test",
    "devnet:init": "pnpm exec ts-mocha -p ./tsconfig.json -t 180000 scripts/cluster-init.ts",
    "mainnet:init": "CLUSTER=mainnet pnpm exec ts-mocha -p ./tsconfig.json -t 180000 scripts/cluster-init.ts",
    "smoke:devnet": "pnpm exec ts-mocha -p ./tsconfig.json -t 180000 scripts/cluster-smoke.ts",
    "smoke:mainnet": "CLUSTER=mainnet pnpm exec ts-mocha -p ./tsconfig.json -t 300000 scripts/cluster-smoke.ts",
    "sim:fund": "pnpm --filter @fomopred/sim exec node --import tsx src/run.ts fund",
    "sim:run": "pnpm --filter @fomopred/sim exec node --import tsx src/run.ts run",
    "sim:report": "pnpm --filter @fomopred/sim exec node --import tsx src/run.ts report",
    "test:e2e": "pnpm exec ts-mocha -p ./tsconfig.json -t 300000 scripts/e2e-devnet.ts",
    "seed:scenarios": "pnpm exec ts-mocha -p ./tsconfig.json -t 300000 scripts/seed-scenario-pots.ts",
    "test:cluster": "pnpm exec ts-mocha -p ./tsconfig.json -t 300000 scripts/seed-scenario-pots.ts",
    "snapshot:ngmi-holders": "node scripts/snapshot-ngmi-holders.mjs",
    "analyse:ngmi-holders": "node scripts/analyse-ngmi-holders.mjs",
    "gpa:ngmi-holders": "node scripts/gpa-ngmi-holders.mjs",
    "enrich:pumpfun-handles": "node scripts/enrich-pumpfun-handles.mjs",
    "airdrop:roster": "node scripts/final-airdrop-roster.mjs",
    "equal:airdrop-roster": "node scripts/equal-airdrop-roster.mjs",
    "execute:devnet-airdrop": "pnpm exec ts-mocha -p ./tsconfig.json -t 600000 scripts/execute-devnet-airdrop.ts",
    "generate:testwallets-page": "node scripts/generate-testwallets-page.mjs"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "^1.5.5",
    "@codama/renderers-js": "^2.3.1",
    "@coral-xyz/anchor": "^0.32.1",
    "@fomopred/fomo-pnl-client": "workspace:^",
    "@fomopred/shared": "workspace:*",
    "@solana-program/system": "^0.14.0",
    "@solana-program/token": "^0.16.0",
    "@solana/kit": "^8.0.0",
    "@solana/kit-plugin-rpc": "^0.18.0",
    "@solana/kit-plugin-signer": "^0.18.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "chai": "^4.3.4",
    "codama": "^1.10.2",
    "mocha": "^9.0.3",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-3gc7-fjrx-p6mg",
        "GHSA-82x6-q7mm-w9cf",
        "GHSA-v5mp-jgw5-2x6j"
      ]
    }
  }
}
